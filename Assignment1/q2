#Assignment 2: Multiple Element Identification
#Question:
#Identify multiple elements of the same type on a webpage and use Selenium to
#find and work with the list of elements.
from selenium import webdriver
from selenium.webdriver.common.by import By
driver = webdriver.Chrome()

driver.get("https://www.selenium.dev/")

#I have used the find_elements() instead of find_element() to get all the links on the page. The find_elements() method returns a list of WebElement objects, which allows us to work with multiple elements at once.
links = driver.find_elements(By.TAG_NAME, "a")

print("Total number of links:", len(links))

for i, link in enumerate(links, start=1):
    print(i, ".", link.text)
input("Press Enter to close the browser...")
driver.quit()
